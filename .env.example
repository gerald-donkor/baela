NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL=
# Neon Console → Branch → Auth → Configuration (same branch as DATABASE_URL).
NEON_AUTH_BASE_URL=
# Generate once with: openssl rand -base64 32. Keep stable across deployments.
NEON_AUTH_COOKIE_SECRET=
ADMIN_AUTH_USER_ID=
# Used only by the durable account-deletion worker (scope this key to the project).
NEON_API_KEY=
NEON_BRANCH_ID=
NEON_PROJECT_ID=
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=sandbox
IMAGEKIT_PRIVATE_KEY=
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY=
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
CRON_SECRET=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_SUPPORT_EMAIL=
# Publishing real legal policies is a deployment prerequisite.
LEGAL_PAGES_APPROVED=false
